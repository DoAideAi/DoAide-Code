{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/guides/:slug([a-z0-9-]+)",
      "destination": "/guides/:slug/index.html"
    },
    {
      "source": "/guides",
      "destination": "/guides/index.html"
    },
    {
      "source": "/vscode",
      "destination": "/vscode/index.html"
    },
    {
      "source": "/github",
      "destination": "/github/index.html"
    },
    {
      "source": "/api-docs",
      "destination": "/api-docs/index.html"
    },
    {
      "source": "/compare/:slug([a-z0-9-]+)",
      "destination": "/compare/:slug/index.html"
    },
    {
      "source": "/embed",
      "destination": "/embed.html"
    },
    {
      "source": "/s/:id([A-Za-z0-9]+)",
      "destination": "/index.html"
    },
    {
      "source": "/tools",
      "destination": "/index.html"
    },
    {
      "source": "/tools/:slug([a-z0-9-]+)",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
