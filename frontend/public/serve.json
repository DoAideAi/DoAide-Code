{
  "cleanUrls": false,
  "headers": [
    {
      "source": "assets/**",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "**/*.@(png|svg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "rewrites": [
    {
      "source": "/guides/:slug([a-z0-9-]+)",
      "destination": "/guides/:slug/index.html"
    },
    {
      "source": "/guides",
      "destination": "/guides/index.html"
    },
    {
      "source": "/vscode",
      "destination": "/vscode/index.html"
    },
    {
      "source": "/github",
      "destination": "/github/index.html"
    },
    {
      "source": "/api-docs",
      "destination": "/api-docs/index.html"
    },
    {
      "source": "/features",
      "destination": "/features/index.html"
    },
    {
      "source": "/compare",
      "destination": "/compare/index.html"
    },
    {
      "source": "/compare/:slug([a-z0-9-]+)",
      "destination": "/compare/:slug/index.html"
    },
    {
      "source": "/free-code-editor-online",
      "destination": "/free-code-editor-online/index.html"
    },
    {
      "source": "/collaboration",
      "destination": "/collaboration/index.html"
    },
    {
      "source": "/embed",
      "destination": "/embed.html"
    },
    {
      "source": "/s/:id([A-Za-z0-9]+)",
      "destination": "/index.html"
    },
    {
      "source": "/tools",
      "destination": "/index.html"
    },
    {
      "source": "/tools/:slug([a-z0-9-]+)",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
