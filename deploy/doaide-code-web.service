[Unit]
Description=DoAide Code web (static SPA)
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=exec
WorkingDirectory=/opt/DoAide-Code/frontend
ExecStart=/usr/bin/serve -s dist -l tcp://172.18.0.1:3098
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
SyslogIdentifier=doaide-code-web

[Install]
WantedBy=multi-user.target
